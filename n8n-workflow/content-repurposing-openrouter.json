    "OR - Email": { "main": [[{ "node": "Merge", "type": "main", "index": 2 }]] },
    "Merge": { "main": [[{ "node": "Shape Output", "type": "main", "index": 0 }]] },
    "Shape Output": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] }
  }
